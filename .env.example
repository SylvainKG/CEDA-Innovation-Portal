# Names only. Never commit values. See docs/process/ci-and-environments.md.
# API mode for the frontend: "mock" (typed mock adapters, no backend) or "supabase" (once the contract and project exist).
# Required in production builds (e.g. Amplify environment variables); only development defaults to "mock".
VITE_API_MODE=mock
# Supabase (frontend, public by design; RLS protects data). Leave empty until the project exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only (never VITE_-prefixed, never reaches the browser). Used by scripts/set-demo-passwords.mjs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Demo account password for the seed (D-17). At least 10 characters. Set per environment; never commit a value.
DEMO_PASSWORD=
