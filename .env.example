# Names only. Never commit values. See docs/process/ci-and-environments.md.
# API mode for the frontend: "mock" (typed mock adapters, no backend) or "supabase" (the real backend; needs the two VITE_SUPABASE_ values).
# Required in production builds (e.g. Amplify environment variables); only development defaults to "mock".
VITE_API_MODE=mock
# Supabase (frontend, public by design; RLS protects data). Set per environment; never commit values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Peolwane AI (Leseding AI Engine). Front-end embed key, public by design and locked by Leseding to this site's origins.
# Leave either empty and the assistant is not shown. See docs/process/peolwane-ai.md. Never commit the key.
VITE_LESEDING_BASE=
VITE_LESEDING_KEY=
# Server-side only (never VITE_-prefixed, never reaches the browser). Used by scripts/set-demo-passwords.mjs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Demo account password for the seed (D-17). At least 12 characters (Auth minimum). Set per environment; never commit a value.
DEMO_PASSWORD=
